{
  "opencollection": "1.0.0",
  "info": {
    "name": "Teradata Query Service API Info Issues API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Issues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Teradata List Issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vantage.teradata.com/api/query/v1/issues"
          },
          "docs": "Retrieve all current issues across the QueryGrid environment."
        }
      ]
    }
  ],
  "bundled": true
}