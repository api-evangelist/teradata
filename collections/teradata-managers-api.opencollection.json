{
  "opencollection": "1.0.0",
  "info": {
    "name": "Teradata Query Service API Info Managers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Teradata List Managers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://vantage.teradata.com/api/query/v1/managers"
          },
          "docs": "Retrieve all QueryGrid Manager instances."
        }
      ]
    }
  ],
  "bundled": true
}